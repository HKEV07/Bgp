auto eth0
iface eth0 inet static
    address 10.1.1.1
    netmask 255.255.255.252
    post-up /sbin/ip link add vxlan10 type vxlan id 10 dstport 4789 group 239.1.1.1 dev eth0
    post-up /sbin/ip link set vxlan10 up
    post-up /sbin/ip link add br0 type bridge
    post-up /sbin/ip link set br0 up
    post-up /sbin/ip link set eth1 master br0
    post-up /sbin/ip link set vxlan10 master br0
    post-up /sbin/ip addr add 30.1.1.1/24 dev br0

auto eth1
iface eth1 inet manual