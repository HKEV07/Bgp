# ============================================================
# _login-1 : Route Reflector (RR)
# Role      : BGP Route Reflector + OSPF backbone router
# Loopback  : 1.1.1.1/32
# Interfaces: eth0 -> _login-2 (10.1.1.0/30)
#             eth1 -> _login-3 (10.1.1.4/30)
#             eth2 -> _login-4 (10.1.1.8/30)
# AS        : 1
# ============================================================

# --- /etc/frr/daemons ---
# Enable the required FRR daemons:
#   zebra=yes
#   bgpd=yes
#   ospfd=yes
#   isisd=yes   (required by Part 1 image, not used in P3 routing)

# --- /etc/frr/zebra.conf ---
# hostname _login-1
# !
# interface lo
#  ip address 1.1.1.1/32
# !
# interface eth0
#  ip address 10.1.1.1/30
# !
# interface eth1
#  ip address 10.1.1.5/30
# !
# interface eth2
#  ip address 10.1.1.9/30
# !

# --- /etc/frr/ospfd.conf ---
# hostname _login-1
# !
# router ospf
#  ospf router-id 1.1.1.1
#  network 1.1.1.1/32 area 0        <- advertise loopback
#  network 10.1.1.0/30 area 0       <- link to _login-2
#  network 10.1.1.4/30 area 0       <- link to _login-3
#  network 10.1.1.8/30 area 0       <- link to _login-4
# !

# --- /etc/frr/bgpd.conf ---
# hostname _login-1
# !
# router bgp 1
#  bgp router-id 1.1.1.1
#  bgp cluster-id 1.1.1.1             <- needed for RR role
#  !
#  # Neighbors are the three VTEPs (iBGP, same AS)
#  neighbor 1.1.1.2 remote-as 1
#  neighbor 1.1.1.2 update-source lo  <- use loopback as source
#  neighbor 1.1.1.3 remote-as 1
#  neighbor 1.1.1.3 update-source lo
#  neighbor 1.1.1.4 remote-as 1
#  neighbor 1.1.1.4 update-source lo
#  !
#  address-family l2vpn evpn
#   neighbor 1.1.1.2 activate
#   neighbor 1.1.1.2 route-reflector-client  <- reflect EVPN routes to all VTEPs
#   neighbor 1.1.1.3 activate
#   neighbor 1.1.1.3 route-reflector-client
#   neighbor 1.1.1.4 activate
#   neighbor 1.1.1.4 route-reflector-client
#  exit-address-family
# !

# --- /etc/network/interfaces (or startup script) ---
# Set IP addresses on interfaces at startup (no default IP per subject rules):
#   ip addr add 1.1.1.1/32 dev lo
#   ip addr add 10.1.1.1/30 dev eth0
#   ip addr add 10.1.1.5/30 dev eth1
#   ip addr add 10.1.1.9/30 dev eth2

# ============================================================
# Verification commands
# ============================================================
# show ip ospf neighbor          -> should see _login-2/3/4
# show ip route ospf             -> should see 1.1.1.2, 1.1.1.3, 1.1.1.4 /32
# show bgp summary               -> 3 neighbors, state=Established
# show bgp l2vpn evpn            -> type-3 routes from each VTEP
