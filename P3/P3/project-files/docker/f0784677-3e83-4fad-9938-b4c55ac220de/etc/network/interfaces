auto lo
iface lo inet loopback
    up /usr/sbin/ip addr add 1.1.1.2/32 dev lo

auto eth0
iface eth0 inet static
    address 10.1.1.2
    netmask 255.255.255.252
    up /usr/sbin/ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.2 nolearning dev lo
    up /usr/sbin/ip link set vxlan10 up
    up /usr/sbin/ip link add br0 type bridge
    up /usr/sbin/ip link set br0 up
    up /usr/sbin/ip link set eth1 master br0
    up /usr/sbin/ip link set vxlan10 master br0

auto eth1
iface eth1 inet manual
    up /usr/sbin/ip link set eth1 up