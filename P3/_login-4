# ============================================================
# _login-4 : VTEP / Leaf router
# Role      : BGP EVPN VTEP (client of RR)
# Loopback  : 1.1.1.4/32
# eth0      : link to _login-1 RR  (10.1.1.10/30)
# eth1      : link to host_login-3
# AS        : 1
# VNI       : 10
# Bridge    : br0
# VXLAN dev : vxlan10
# ============================================================

# --- /etc/frr/zebra.conf ---
# hostname _login-4
# !
# interface lo
#  ip address 1.1.1.4/32
# !
# interface eth0
#  ip address 10.1.1.10/30
# !

# --- /etc/frr/ospfd.conf ---
# hostname _login-4
# !
# router ospf
#  ospf router-id 1.1.1.4
#  network 1.1.1.4/32 area 0
#  network 10.1.1.8/30 area 0
# !

# --- /etc/frr/bgpd.conf ---
# hostname _login-4
# !
# router bgp 1
#  bgp router-id 1.1.1.4
#  !
#  neighbor 1.1.1.1 remote-as 1
#  neighbor 1.1.1.1 update-source lo
#  !
#  address-family l2vpn evpn
#   neighbor 1.1.1.1 activate
#   advertise-all-vni
#  exit-address-family
# !

# --- VXLAN + bridge setup ---
#
#   ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.4 nolearning
#   ip link set vxlan10 up
#   ip link add br0 type bridge
#   ip link set br0 up
#   ip link set vxlan10 master br0
#   ip link set eth1 master br0       <- eth1 faces host_login-3

# --- Startup IP config ---
#   ip addr add 1.1.1.4/32 dev lo
#   ip addr add 10.1.1.10/30 dev eth0

