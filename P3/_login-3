# ============================================================
# _login-3 : VTEP / Leaf router
# Role      : BGP EVPN VTEP (client of RR)
# Loopback  : 1.1.1.3/32
# eth0      : link to _login-1 RR  (10.1.1.6/30)
# eth1      : link to host_login-2
# AS        : 1
# VNI       : 10
# Bridge    : br0
# VXLAN dev : vxlan10
# ============================================================

# --- /etc/frr/zebra.conf ---
# hostname _login-3
# !
# interface lo
#  ip address 1.1.1.3/32
# !
# interface eth0
#  ip address 10.1.1.6/30
# !

# --- /etc/frr/ospfd.conf ---
# hostname _login-3
# !
# router ospf
#  ospf router-id 1.1.1.3
#  network 1.1.1.3/32 area 0
#  network 10.1.1.4/30 area 0
# !

# --- /etc/frr/bgpd.conf ---
# hostname _login-3
# !
# router bgp 1
#  bgp router-id 1.1.1.3
#  !
#  neighbor 1.1.1.1 remote-as 1
#  neighbor 1.1.1.1 update-source lo
#  !
#  address-family l2vpn evpn
#   neighbor 1.1.1.1 activate
#   advertise-all-vni
#  exit-address-family
# !

# --- VXLAN + bridge setup ---
#
#   ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.3 nolearning
#   ip link set vxlan10 up
#   ip link add br0 type bridge
#   ip link set br0 up
#   ip link set vxlan10 master br0
#   ip link set eth1 master br0       <- eth1 faces host_login-2

# --- Startup IP config ---
#   ip addr add 1.1.1.3/32 dev lo
#   ip addr add 10.1.1.6/30 dev eth0

# ============================================================
# Verification commands (on _login-3)
# ============================================================
# show bgp l2vpn evpn                   -> see routes from _login-2 and _login-4
# show bgp l2vpn evpn route type 2      -> MAC routes after hosts come up
# show bgp l2vpn evpn route type 3      -> IMET routes (tunnel endpoints)
# brctl showmacs br0
