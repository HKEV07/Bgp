auto lo
iface lo inet loopback
    up /sbin/ip addr add 1.1.1.1/32 dev lo

auto eth0
iface eth0 inet static
    address 10.1.1.1
    netmask 255.255.255.252

auto eth1
iface eth1 inet static
    address 10.1.1.5
    netmask 255.255.255.252

auto eth2
iface eth2 inet static
    address 10.1.1.9
    netmask 255.255.255.252